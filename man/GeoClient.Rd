\subsection{\code{GeoClient$get_ogc()}}{
  Get features from a DGT OGC API collection.

Queries \verb{https://ogcapi.dgterritorio.gov.pt/} and returns the response
as an sf object. Use this for filtered or bounded subsets (single
municipio, bbox around a city, COS land-cover by area). For bulk
country-wide downloads of CAOP, \verb{$get_caop()} is faster.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{GeoClient$get_ogc(
  collection,
  bbox = NULL,
  bbox_crs = 4326L,
  properties = NULL,
  cql_filter = NULL,
  crs = NULL,
  limit = OGC_DEFAULT_LIMIT,
  max_features = Inf
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{collection}}{Collection id, e.g. "freguesias", "municipios",
"nuts3", "cos2023v1". See \verb{$list_ogc_collections()}; an id geopt
doesn't know is an error that lists the ones it does. The large
collections (\code{"cos2018v3"}, \code{"cos2023v1"}, \code{"cadastro"}) need a
\code{bbox}, \code{properties} or \code{cql_filter}.}
      \item{\code{bbox}}{Numeric length-4 vector \code{c(xmin, ymin, xmax, ymax)} or an
sf \code{bbox} object. If NULL, no spatial filter is applied.}
      \item{\code{bbox_crs}}{Integer EPSG code that \code{bbox} is expressed in.
Defaults to 4326. Only sent to the server when not 4326.}
      \item{\code{properties}}{Named list of equality filters on attribute columns,
e.g. \code{list(distrito = "Lisboa")}. Use \code{cql_filter} for more complex
predicates.}
      \item{\code{cql_filter}}{Optional CQL-Text filter string, passed through
verbatim. Example: \code{"distrito_ilha = 'Lisboa'"}. DGT's server
accepts CQL1 syntax (\code{cql-text}), not CQL2.}
      \item{\code{crs}}{Output EPSG code. If NULL, uses the client default. Requested
server-side to avoid client-side reprojection.}
      \item{\code{limit}}{Page size sent to the server. Default 1000.}
      \item{\code{max_features}}{Stop pagination after this many features. Defaults
to \code{Inf} (fetch everything).}
    }
    \if{html}{\out{</div>}}
  }
